# 저장소 루트 .env. 복사해서 쓴다: cp .env.example .env
# 로컬 개발 스택(infra/compose.yml)과 VM 운영 스택(루트 compose.yml)이 함께 읽는다. 각자 쓰는 키만 채우면 된다.

# --- 공통 ---

# MediaMTX가 브라우저에 알려줄 WebRTC 호스트. 쉼표로 여러 개 가능.
# 로컬: PC 내부 IP(macOS: ipconfig getifaddr en0). VM: 고정 외부 IP.
WEBRTC_ADDITIONAL_HOSTS=192.168.0.10

# --- 로컬 개발 스택(infra/compose.yml) ---

# Caddy가 호스트에서 받을 HTTP 포트(Spring bootRun의 8080과 겹치지 않게 8000). 터널은 http://localhost:<이 값>으로 붙인다.
HTTP_PORT=8000

# MediaMTX가 인증 콜백(/internal/mediamtx/auth)과 훅으로 부를 Spring 주소. 로컬은 호스트의 bootRun.
FFLUX_SERVER_URL=http://host.docker.internal:8080

# --- VM 운영 스택(루트 compose.yml) ---

# Caddy 사이트 주소(API·미디어 서버). 이 도메인으로 자동 HTTPS 인증서를 받는다.
DOMAIN=api.fflux.kro.kr

# 인증서 발급(ACME) 계정 이메일. Let's Encrypt 한도에 걸리면 ZeroSSL로 넘어가는 데 필요하다.
ACME_EMAIL=you@example.com

# 띄울 Spring 이미지 태그(ghcr.io/maruhxn/fflux-app). 비우면 latest. 되돌릴 때만 커밋 SHA를 준다.
APP_TAG=

# API를 부르는 프론트(Vercel) 출처. 쉼표로 여러 개 가능.
CORS_ALLOWED_ORIGINS=https://fflux.kro.kr

# MySQL 비밀번호
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# 평가용 테스트 계정(streamer, viewer) 비밀번호. 비어 있으면 그 계정은 만들지 않는다.
TEST_STREAMER_PASSWORD=change-me-streamer
TEST_VIEWER_PASSWORD=change-me-viewer

# 토스페이먼츠 시크릿 키(후원 결제 승인). 개발자센터 [API 키] > API 개별 연동 키의 테스트 시크릿 키(test_sk_…). infra/README.md 참고.
TOSS_SECRET_KEY=test_sk_change-me

# 평가용 테스트 계정 로그인 버튼(비밀번호 없이 streamer/viewer로 로그인). 끄려면 false.
TEST_ACCOUNTS_ENABLED=true
