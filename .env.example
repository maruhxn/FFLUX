# 로컬 개발 스택(infra/compose.yml)용 환경변수. 복사해서 .env로 쓴다: cp .env.example .env

# Caddy가 호스트에서 받을 HTTP 포트(Spring bootRun의 8080과 겹치지 않게 8000). 터널은 http://localhost:<이 값>으로 붙인다.
HTTP_PORT=8000

# MediaMTX가 브라우저에 알려줄 WebRTC 호스트(PC 내부 IP). 쉼표로 여러 개 가능.
# macOS: ipconfig getifaddr en0
WEBRTC_ADDITIONAL_HOSTS=192.168.0.10
